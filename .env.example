# Production database (set automatically by Vercel's Neon integration). Leave unset locally to use PGlite.
DATABASE_URL=

# First family account, created on the first deploy when nobody exists yet. Remove OWNER_PASSWORD afterwards.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Local dev only: where PGlite keeps its data (default ./.data/pglite). Use memory:// for a throwaway database.
PGLITE_DIR=
