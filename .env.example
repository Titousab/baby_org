# Production database: your Railway Postgres's DATABASE_PUBLIC_URL (set in Vercel as DATABASE_URL).
# Leave unset locally to use a built-in local database (PGlite) instead.
DATABASE_URL=

# First family account, created on the first deploy when nobody exists yet. Remove OWNER_PASSWORD afterwards.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Local dev only: where PGlite keeps its data (default ./.data/pglite). Use memory:// for a throwaway database.
PGLITE_DIR=
